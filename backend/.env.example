# MaxMind GeoLite2 City DB (download from maxmind.com, place locally)
MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb

# Shodan API key (https://account.shodan.io/)
SHODAN_API_KEY=

# Fine-tuned model paths (leave default to use graceful heuristic fallback)
DISTILBERT_MODEL_PATH=./models/distilbert-phishing-intent
XGB_MODEL_PATH=./models/xgb_header_anomaly.json

# Optional forensic log anchoring (Sepolia/testnet)
BLOCKCHAIN_LOGGING_ENABLED=false
TESTNET_RPC_URL=
WALLET_PRIVATE_KEY=
LOG_CONTRACT_ADDRESS=
